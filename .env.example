# PCN Cloud ANPR — copy to .env and adjust. Never commit real secrets.

# --- App ---
APP_NAME=PCN Cloud ANPR
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SEED_DEMO_DATA=true

# --- Database (legacy only) ---
# Unused for normal runtime when DATASTORE_PROVIDER=firestore.
# Required only for DATASTORE_PROVIDER=sqlalchemy (legacy tests / local SQL).
# DATABASE_URL=postgresql+asyncpg://pcn:pcn@localhost:5432/pcn_cloud

# --- Auth ---
# Generate a long random string for production (legacy JWT path).
JWT_SECRET=change-me-dev-jwt-secret-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for camera credential encryption at rest (url-safe base64, 32 bytes).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# --- Providers (Firebase-first defaults) ---
AUTH_PROVIDER=firebase
DATASTORE_PROVIDER=firestore
STORAGE_PROVIDER=firebase
STORAGE_PATH=./data/storage

# --- Firebase (pcn-anpr) ---
# Never commit service-account JSON or private keys.
# Set FIREBASE_CREDENTIALS_FILE to your Admin SDK JSON path for local/dev.
FIREBASE_PROJECT_ID=pcn-anpr
FIREBASE_STORAGE_BUCKET=pcn-anpr.firebasestorage.app
# Local path to service account JSON (download from Firebase Console → Project settings → Service accounts)
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CREDENTIALS_JSON=
# Web client config (public identifiers — OK in env; never Admin private keys)
FIREBASE_API_KEY=AIzaSyAkOKXgxJIDVpdTZ9vJWzzqOMYEYRZH_10
FIREBASE_AUTH_DOMAIN=pcn-anpr.firebaseapp.com
FIREBASE_APP_ID=1:578705993260:web:56ca05b58f6c1731d46b89
FIREBASE_MESSAGING_SENDER_ID=578705993260
FIREBASE_MEASUREMENT_ID=G-LFDHNP5EF9
# Optional Vite mirrors for the SPA SDK
# VITE_FIREBASE_API_KEY=AIzaSyAkOKXgxJIDVpdTZ9vJWzzqOMYEYRZH_10
# VITE_FIREBASE_AUTH_DOMAIN=pcn-anpr.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=pcn-anpr
# VITE_FIREBASE_APP_ID=1:578705993260:web:56ca05b58f6c1731d46b89
# VITE_FIREBASE_STORAGE_BUCKET=pcn-anpr.firebasestorage.app

# --- Redis (optional; in-memory rate limits used if unset) ---
REDIS_URL=

# --- Frontend ---
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# --- Edge Agent ---
API_BASE_URL=http://localhost:8000
EDGE_AGENT_ID=
SITE_ID=
EDGE_AGENT_KEY=
EDGE_POLL_INTERVAL_SECONDS=5
EDGE_SQLITE_PATH=./data/edge-queue.db

# Mock ANPR one-shot (no camera required). Set false for continuous RTSP loop.
EDGE_MOCK_MODE=true
EDGE_MOCK_ONESHOT=true

# Live RTSP capture (Phase 5). Requires FFmpeg on PATH when EDGE_MOCK_MODE=false.
# Continuous FFmpeg decode per camera; sample rate defaults to 2 FPS.
EDGE_RTSP_ENABLED=true
# Prefer EDGE_SAMPLE_FPS=2, or set interval seconds (0.5 = 2 FPS). EDGE_SAMPLE_FPS wins if set.
EDGE_FRAME_INTERVAL=0.5
# EDGE_SAMPLE_FPS=2
EDGE_WARMUP_FRAMES=8
EDGE_MIN_JPEG_BYTES=1500
EDGE_RECONNECT_MIN_SECONDS=1
EDGE_RECONNECT_MAX_SECONDS=30
EDGE_RTSP_TIMEOUT_SECONDS=15
# Relative path for detection snapshots (not every frame)
EDGE_FRAME_SAVE_DIR=./data/edge-frames
# false = save JPEG only when vehicle/plate/ANPR hit; true = dump every sampled frame
DEBUG_SAVE_ALL_FRAMES=false
EDGE_ANPR_FRAME_HOOK=true
EDGE_FRAME_RING_SIZE=15
EDGE_SNAPSHOT_MAX_FILES=100

# --- Phase 6B live ANPR (RTSP → temporal confirm → ENTRY/EXIT). Default off. ---
ANPR_LIVE_ENABLED=false
ANPR_DEBUG_MODE=false
# Requires ANPR_DEBUG_MODE=true. Saves sampled frames (~1 FPS) under ANPR_DEBUG_FRAMES_DIR.
ANPR_DEBUG_SAVE_FRAMES=false
ANPR_DEBUG_SAVE_FPS=1
ANPR_DEBUG_FRAMES_DIR=./data/debug-frames
ANPR_DEBUG_FRAMES_MAX_FILES=100
ANPR_CONFIRM_MIN_OBSERVATIONS=3
ANPR_CONFIRM_WINDOW_SECONDS=2
ANPR_EVENT_COOLDOWN_SECONDS=120
ANPR_INFER_QUEUE_SIZE=8

# --- ANPR engine (Phase 6A — image inference; also used by live worker) ---
ANPR_ENABLED=true
OCR_ENABLED=true
PLATE_DETECTOR_ENABLED=true
VEHICLE_DETECTOR_ENABLED=true
# Vehicle detector: yolo (default, AGPL Ultralytics YOLOv8n) | opencv | mock
ANPR_VEHICLE_DETECTOR=yolo
# Optional override; default is {ANPR_MODEL_DIR}/vehicle/yolov8n.pt
# ANPR_YOLO_VEHICLE_WEIGHTS=
# ANPR_YOLO_VEHICLE_CONF=0.35
ANPR_MIN_PLATE_CONFIDENCE=0.25
ANPR_MIN_OCR_CONFIDENCE=0.30
ANPR_CONFUSABLE_SUBSTITUTION=false
ANPR_PROVIDER_MODE=real
ANPR_MODEL_DIR=./models
# Plate detector: opencv (default) | ai | compare — never ship AI as default
ANPR_PLATE_DETECTOR=opencv
# Optional local AI plate weights dir (not downloaded; see anpr-engine/models/README.md)
ANPR_AI_PLATE_MODEL_DIR=
ANPR_OUTPUT_DIR=./output
ANPR_PLATE_PAD_RATIO=0.20
ANPR_OCR_UPSCALE_2X=true
ANPR_OCR_UPSCALE_3X=true
ANPR_OCR_SAVE_DEBUG_CROPS=true
ANPR_OCR_DEBUG_DIR=./output/ocr_debug
