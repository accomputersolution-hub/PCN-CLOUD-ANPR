# Copy to .env on the gateway device. Never commit real keys.

API_BASE_URL=https://api.example.invalid
GATEWAY_ID=
GATEWAY_DEVICE_KEY=

# Provider plugin id — not a hardware SKU.
# Examples: generic_wireguard | existing_router | future_er605
VPN_PROVIDER=generic_wireguard

HEARTBEAT_INTERVAL_SECONDS=30
RECONNECT_MIN_SECONDS=2
RECONNECT_MAX_SECONDS=60
LOG_LEVEL=INFO
