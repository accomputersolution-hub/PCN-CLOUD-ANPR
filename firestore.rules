rules_version = '2';

// Tenant-isolated client rules for PCN Cloud ANPR (pcn-anpr).
// Backend Admin SDK bypasses these rules. Client writes are denied;
// privileged writes go through the FastAPI backend.
// ruleset-rev: tenant-isolation-2026-09-17c

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function sameOrg(orgId) {
      return signedIn()
        && userDoc().organization_id == orgId
        && userDoc().is_active == true;
    }

    function isSuperAdmin() {
      return signedIn() && userDoc().role == 'SUPER_ADMIN';
    }

    function siteAllowed(siteId) {
      return isSuperAdmin()
        || (signedIn()
          && userDoc().is_active == true
          && (
            !('site_ids' in userDoc())
            || userDoc().site_ids == null
            || userDoc().site_ids.size() == 0
            || siteId in userDoc().site_ids
          ));
    }

    match /organizations/{orgId} {
      allow read: if isSuperAdmin() || sameOrg(orgId);
      allow write: if false;
    }

    match /sites/{siteId} {
      allow read: if (isSuperAdmin() || sameOrg(resource.data.organization_id))
        && siteAllowed(siteId);
      allow write: if false;
    }

    match /gates/{gateId} {
      allow read: if (isSuperAdmin() || sameOrg(resource.data.organization_id))
        && siteAllowed(resource.data.site_id);
      allow write: if false;
    }

    match /gateways/{gatewayId} {
      allow read: if (isSuperAdmin() || sameOrg(resource.data.organization_id))
        && siteAllowed(resource.data.site_id);
      allow write: if false;
    }

    match /nvrs/{nvrId} {
      allow read: if (isSuperAdmin() || sameOrg(resource.data.organization_id))
        && siteAllowed(resource.data.site_id);
      allow write: if false;
    }

    match /cameras/{cameraId} {
      allow read: if (isSuperAdmin() || sameOrg(resource.data.organization_id))
        && siteAllowed(resource.data.site_id);
      allow write: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isSuperAdmin() || sameOrg(resource.data.organization_id);
      allow write: if false;
    }

    match /vehicleVisits/{visitId} {
      allow read: if (isSuperAdmin() || sameOrg(resource.data.organization_id))
        && siteAllowed(resource.data.site_id);
      allow write: if false;
    }

    match /anprEvents/{eventId} {
      allow read: if (isSuperAdmin() || sameOrg(resource.data.organization_id))
        && siteAllowed(resource.data.site_id);
      allow write: if false;
    }

    match /edgeAgents/{agentId} {
      allow read: if (isSuperAdmin() || sameOrg(resource.data.organization_id))
        && siteAllowed(resource.data.site_id);
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isSuperAdmin()
        || sameOrg(resource.data.organization_id)
      );
      allow write: if false;
    }

    // Refresh tokens are server-only (Admin SDK). Deny all client access.
    match /refreshTokens/{tokenId} {
      allow read, write: if false;
    }

    // Deny smoke/test leftovers to clients; Admin SDK still manages them.
    match /_smoke/{docId} {
      allow read, write: if false;
    }
  }
}
